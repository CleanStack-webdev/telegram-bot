# ---- Telegram bot (from @BotFather) ----
BOT_TOKEN=123456789:replace-with-your-bot-token

# ---- Telegram API credentials (https://my.telegram.org -> API development tools) ----
API_ID=1234567
API_HASH=replace-with-your-api-hash

# ---- Output of scripts/generate_session.py (treat like a password!) ----
TELETHON_SESSION=replace-with-your-session-string

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service-role / secret key. Server-side only. Never put it in a browser or a public repo.
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key

# ---- Webhook ----
# Random string: letters, digits, _ and - only (max 256 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-a-long-random-string
# Public https URL of your deployment. On Render leave EMPTY (RENDER_EXTERNAL_URL is used automatically).
PUBLIC_URL=

# ---- Optional behaviour ----
# Comma-separated group IDs the bot may serve (e.g. -1001234567890). Empty = any group. Recommended: set it.
ALLOWED_CHAT_IDS=
# admins = only group admins may run /all, everyone = any member
ALL_PERMISSION=admins
MENTIONS_PER_MESSAGE=20
ALL_COOLDOWN_SECONDS=30
INCLUDE_BOTS=false
MAX_FLOOD_WAIT_SECONDS=120
